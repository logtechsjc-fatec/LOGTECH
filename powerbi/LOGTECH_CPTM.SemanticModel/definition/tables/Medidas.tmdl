	measure 'Posição do Estoque (R$)' =
			VAR ref = [Data Base Estoque]
			VAR fimMes = MAX ( dCalendario[Date] )
			VAR iniMes = MIN ( dCalendario[Date] )
			VAR d = MIN ( fimMes, ref )
			RETURN
			    IF (
			        iniMes <= ref && fimMes >= DATE ( 2021, 1, 31 ),
			        [Valor Estoque (RES47)]
			            - CALCULATE (
			                SUM ( RES82_20260825[Valor Líquido] ),
			                REMOVEFILTERS ( dCalendario ),
			                RES82_20260825[Entrada] > d,
			                RES82_20260825[Entrada] <= ref
			            )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Consumo e Aderência
		lineageTag: 23ebd0f3-eb8b-4ab4-a3a4-f1e3feaa7ecc

	measure 'PCA Anual (RES43)' =
			[PCA Mensal] * 12
		formatString: #,0.##
		displayFolder: Consumo e Aderência
		lineageTag: 4c3489f3-3faa-49fd-9362-c0a5216700b0

	measure 'Aderência PCA (%)' =
			DIVIDE ( [Consumo 12m (Qtd)], [PCA Anual (RES43)] )
		formatString: 0%
		displayFolder: Consumo e Aderência
		lineageTag: f94ec552-ebc4-48bd-a7fc-29ddb0a07c6b

	measure 'Classe Aderência' =
			VAR p = [PCA Anual (RES43)]
			VAR c = COALESCE ( [Consumo 12m (Qtd)], 0 )
			RETURN
			    IF (
			        NOT ISBLANK ( p ),
			        SWITCH (
			            TRUE (),
			            p <= 0 && c > 0, "Consumo sem PCA",
			            p <= 0, BLANK (),
			            c = 0, "Sem consumo",
			            c / p < 0.8, "Abaixo do planejado",
			            c / p <= 1.2, "Aderente",
			            "Acima do planejado"
			        )
			    )
		displayFolder: Consumo e Aderência
		lineageTag: e1ec88bd-4611-4041-8701-edf063a17064

	measure 'Materiais na Classe' =
