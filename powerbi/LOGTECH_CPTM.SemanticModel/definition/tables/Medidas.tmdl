	measure 'Consumo 12m (Qtd)' =
			VAR ref = [Data Base Estoque]
			RETURN
			    CALCULATE (
			        SUM ( RES82_20260825[Qtde.] ),
			        'Tipo de Movimentação'[Categoria] = "Consumo efetivo",
			        REMOVEFILTERS ( dCalendario ),
			        RES82_20260825[Entrada] > EDATE ( ref, -12 ),
			        RES82_20260825[Entrada] <= ref
			    )
		formatString: #,0.##
		displayFolder: Indicadores Logísticos
		lineageTag: eaaa090e-bfc0-4886-829c-f5498fbe91f8

	measure 'Consumo 12m (R$)' =
			VAR ref = [Data Base Estoque]
			RETURN
			    CALCULATE (
			        SUM ( RES82_20260825[Valor Total] ),
			        'Tipo de Movimentação'[Categoria] = "Consumo efetivo",
			        REMOVEFILTERS ( dCalendario ),
			        RES82_20260825[Entrada] > EDATE ( ref, -12 ),
			        RES82_20260825[Entrada] <= ref
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Indicadores Logísticos
		lineageTag: 94d50d0e-c67a-49e9-afc1-95f3aa78fb6e

	measure 'Consumo Médio Mensal 12m' =
			DIVIDE ( [Consumo 12m (Qtd)], 12 )
		formatString: #,0.##
		displayFolder: Indicadores Logísticos
		lineageTag: 7173e0c8-598f-48aa-9cc3-4518df7fcc14

	measure 'Cobertura Material (meses)' =
			DIVIDE ( [Saldo Qtd (RES47)], [Consumo Médio Mensal 12m] )
		formatString: #,0.0
		displayFolder: Indicadores Logísticos
		lineageTag: c31e2771-c617-49d9-9e50-1c577428825d

	measure 'Cobertura Estoque (meses)' =
			DIVIDE ( [Valor Estoque (RES47)], DIVIDE ( [Consumo 12m (R$)], 12 ) )
		formatString: #,0.0
		displayFolder: Indicadores Logísticos
		lineageTag: ba595bef-3007-48a6-8a1f-691c7876374b

	measure 'Estoque Médio 12m (R$)' =
			VAR ref = [Data Base Estoque]
			VAR atual = [Valor Estoque (RES47)]
			RETURN
			    AVERAGEX (
			        GENERATESERIES ( 0, 12, 1 ),
			        VAR d = IF ( [Value] = 12, ref, EOMONTH ( ref, [Value] - 12 ) )
			        RETURN
			            atual
			                - CALCULATE (
			                    SUM ( RES82_20260825[Valor Líquido] ),
			                    REMOVEFILTERS ( dCalendario ),
			                    RES82_20260825[Entrada] > d,
			                    RES82_20260825[Entrada] <= ref
			                )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Indicadores Logísticos
		lineageTag: 4de5742b-da9b-494c-a8fe-86441e3848fc

	measure 'Giro de Estoque' =
			DIVIDE ( [Consumo 12m (R$)], [Estoque Médio 12m (R$)] )
		formatString: #,0.00
		displayFolder: Indicadores Logísticos
		lineageTag: d52670a2-41c1-4c15-a790-6592c163b1cd

	measure 'Estoque Fim do Mês (R$)' =
			VAR ref = [Data Base Estoque]
			VAR fimMes = MAX ( dCalendario[Date] )
			VAR iniMes = MIN ( dCalendario[Date] )
			VAR d = MIN ( fimMes, ref )
			RETURN
			    IF (
			        fimMes >= EOMONTH ( ref, -12 ) && iniMes <= ref,
			        [Valor Estoque (RES47)]
			            - CALCULATE (
			                SUM ( RES82_20260825[Valor Líquido] ),
			                REMOVEFILTERS ( dCalendario ),
			                RES82_20260825[Entrada] > d,
			                RES82_20260825[Entrada] <= ref
			            )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Indicadores Logísticos
		lineageTag: 2a6db966-9acb-433f-ba98-9c1c4b353b25

	measure 'Limite Risco (meses)' =
			SELECTEDVALUE ( 'Parâmetro Risco'[Risco (meses)], 3 )
		formatString: 0
		displayFolder: Indicadores Logísticos
		lineageTag: 46e1d5f1-449a-47d7-93bf-eaaf4f7b0409

	measure 'Limite Excesso (meses)' =
			SELECTEDVALUE ( 'Parâmetro Excesso'[Excesso (meses)], 24 )
		formatString: 0
		displayFolder: Indicadores Logísticos
		lineageTag: 76d80cf4-c0b1-4647-8e39-24efd33e118f

	measure 'Status Estoque' =
			VAR s = COALESCE ( [Saldo Qtd (RES47)], 0 )
			VAR c = COALESCE ( [Consumo Médio Mensal 12m], 0 )
			VAR cob = DIVIDE ( s, c )
			RETURN
			    SWITCH (
			        TRUE (),
			        c > 0 && s <= 0, "Ruptura",
			        c > 0 && cob < [Limite Risco (meses)], "Risco de ruptura",
			        c > 0 && cob > [Limite Excesso (meses)], "Excesso",
			        c > 0, "Adequado",
			        s > 0, "Sem consumo 12m",
			        BLANK ()
			    )
		displayFolder: Indicadores Logísticos
		lineageTag: 9f42d423-7e65-4137-bc0a-e0a3ec33cc39

	measure 'Prioridade' =
			SWITCH ( [Status Estoque], "Ruptura", 1, "Risco de ruptura", 2, "Excesso", 3, "Sem consumo 12m", 4, "Adequado", 5 )
		formatString: 0
		displayFolder: Indicadores Logísticos
		lineageTag: d603818d-dfe0-4e96-8a31-7c1d6595d28c

	measure 'Cor Status' =
			SWITCH ( [Status Estoque], "Ruptura", "#C8102E", "Risco de ruptura", "#E07B00", "Adequado", "#2E8B57", "Excesso", "#1F5FBF", "Sem consumo 12m", "#7A869A" )
		displayFolder: Indicadores Logísticos
		lineageTag: 4225ead4-4205-46e6-b8f8-1c4c1a1ffb37

	measure 'Cor Status Barra' =
