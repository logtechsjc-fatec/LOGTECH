			    ISBLANK ( RES34_20260824[Reciclagem] ), ISBLANK ( RES34_20260824[Log. Reversa] ), ISBLANK ( RES34_20260824[Aterro] )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
