	measure 'Estoque Inicial 12m (Qtd)' =
			VAR ref = [Data Base Estoque]
			VAR movLiquido =
			    CALCULATE (
			        SUM ( RES82_20260825[Qtd Líquida] ),
			        REMOVEFILTERS ( dCalendario ),
			        RES82_20260825[Entrada] > EDATE ( ref, -12 ),
			        RES82_20260825[Entrada] <= ref
			    )
			RETURN MAX ( 0, COALESCE ( [Saldo Qtd (RES47)], 0 ) - COALESCE ( movLiquido, 0 ) )
		formatString: #,0.##
		displayFolder: Giro e Rotatividade
		lineageTag: 4b90cd7f-9da7-4ef3-9fc7-a9b0cbd54b6d

	measure 'Estoque Médio Material (Qtd)' =
			( [Estoque Inicial 12m (Qtd)] + COALESCE ( [Saldo Qtd (RES47)], 0 ) ) / 2
		formatString: #,0.##
		displayFolder: Giro e Rotatividade
		lineageTag: 7e9ff73d-c33f-4cc8-b92c-222df2e32453

	measure 'Giro Material 12m' =
