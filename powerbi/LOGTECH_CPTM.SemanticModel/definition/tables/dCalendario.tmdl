	partition dCalendario = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2021, 1, 1 ), DATE ( 2026, 12, 31 ) ),
				    "Ano", YEAR ( [Date] ),
				    "Mês Num", MONTH ( [Date] ),
				    "Mês", FORMAT ( [Date], "mmm/yy" ),
				    "Ano-Mês", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Mês do Ano", FORMAT ( [Date], "mmm" )
				)

	annotation PBI_Id = ba6256d5557140ca905b85f35a31d2e1
